# Copy to `.env` and fill in. Never commit `.env`.

# GitHub — raise the hourly API limit from 60 to 5,000 requests.
#   Create a token: https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=

# LangSmith — optional tracing + evaluation (free Developer tier).
#   https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=career-intelligence-evaluation

# Embedding model (sentence-transformers, all-MiniLM-L6-v2 = 384 dims).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Job API — provider (only "jobicy" is implemented).
JOB_API_PROVIDER=jobicy

# Job cache — how long fetched/normalized jobs stay fresh (hours).
JOB_CACHE_TTL_HOURS=6
# Optional override for the SQLite cache file.
JOB_CACHE_DB=backend/data/jobs.db
